PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional explicit persistence path. Railway currently mounts /data and symlinks data/ to it.
DATA_PATH=

# Provider abstraction defaults to bundled/server demo data.
FOOTBALL_PROVIDER=demo
FOOTBALL_API_BASE_URL=
FOOTBALL_API_KEY=
